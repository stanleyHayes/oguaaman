# Marketing site — production build config (Vite loads this on `vite build`).
# Public URLs only (Vite ships VITE_* to the client), safe to commit.
#
# Domain map (live):
#   oguaaman.com          → this marketing site
#   citizen.oguaaman.com  → the citizen portal (frontend/)
#   creator.oguaaman.com  → the creator studio (creator/)

# The citizen web app that every "Open the app" / "Sign in" CTA opens.
VITE_PORTAL_URL=https://citizen.oguaaman.com

# Canonical/site URL of THIS marketing site. Every canonical, og:url and
# sitemap entry is built from it (see plugins/seo-prerender.ts) — changing it
# re-points search engines, so keep it on the live apex domain.
VITE_SITE_URL=https://oguaaman.com

# Backend API origin. Absolute so the deployed site reaches the API — there is
# no same-origin /api proxy on Vercel.
VITE_API_URL=https://api.oguaaman.com
