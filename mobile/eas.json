{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.oguaaman.com",
        "EXPO_PUBLIC_PORTAL_URL": "https://citizen.oguaaman.com",
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_SIMULATE_PAYMENTS": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
