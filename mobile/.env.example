# Oguaa mobile app (Expo) — environment variables.
# Copy to .env.local for development, fill values in your EAS Build secrets for production.

# API origin — on a physical device set this to your machine's LAN IP.
# Production: https://api.oguaaman.com
EXPO_PUBLIC_API_URL=http://localhost:8080
# Public web portal. iOS pledges open here in Safari (App Store 3.2.2).
# Production: https://citizen.oguaaman.com
EXPO_PUBLIC_PORTAL_URL=http://localhost:5173

# Image uploads use signed Cloudinary uploads (POST /api/uploads/cloudinary-signature)
# and fall back to the API's own /api/uploads. No Cloudinary keys belong in the app.

# Expo / EAS project config (eas.json / app.config.ts reference these).
# Get from expo.dev → your project.
EXPO_PROJECT_ID=
EXPO_PUBLIC_APP_ENV=development

# Google Maps API key (Android — for native MapView, if used).
# console.cloud.google.com → APIs & Services → Credentials
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Push notifications (Expo Push Service or FCM/APNs direct).
# Managed via EAS — no key needed in .env if using Expo's managed service.
# FCM Server Key (Android direct, optional):
# EXPO_PUBLIC_FCM_SERVER_KEY=

# Payment provider: "paystack" (default, hosted checkout in in-app browser) or
# "stripe" (native PaymentSheet). Leave as paystack unless you have Stripe keys.
EXPO_PUBLIC_PAYMENT_PROVIDER=paystack
# Paystack needs no key in the app: checkout opens the backend-hosted Paystack
# page, and only the API holds PAYSTACK_SECRET_KEY. Never put a secret key in an
# EXPO_PUBLIC_ variable.
# Stripe publishable key for mobile PaymentSheet. Must be paired with the
# backend STRIPE_SECRET_KEY. dashboard.stripe.com → Developers → API keys.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Dev-only: set "true" to allow simulated payment auto-confirmation when no
# provider key is configured. Never enable in production.
EXPO_PUBLIC_SIMULATE_PAYMENTS=false
